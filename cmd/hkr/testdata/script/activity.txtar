# What HKr did with the organization's code, newest first: deliveries
# from the git host, the pull requests it opened, lock file reads.
env HKR_TOKEN=hkrp_test_token_laptop
env HKR_ORG=acme
fake-hkr repos.list.ok activity.list.ok activity.list.invalid
exits 0 hkr activity --repo acme/web
stdout '^WHEN               REPOSITORY  WHAT$'
stdout '^18 Nov 2026 12:00  acme/web    push main a3f21c9d8e7b by ana → reviewed \(1 comment\)$'
stdout '^18 Nov 2026 12:00  acme/web    lock files main a1b2c3d4e5f6 · 1/1 read$'

# repos activity is the same list for one repository.
exits 0 hkr repos activity RepWeb7Kq2Xp
stdout 'push main a3f21c9d8e7b by ana → reviewed \(1 comment\)$'

exits 0 hkr activity --repo acme/web --json
stdout '"kind": "delivery"'

exits 2 hkr activity --kind everything
stderr 'unknown --kind "everything": use delivery, pull_request or dependencies'

# Every kind: a skipped delivery says why, a fix pull request what it fixes.
exits 0 hkr activity --repo acme/web
stdout '^18 Nov 2026 12:00  acme/web    push spike/search [0-9a-f]{12} by \S+ → skipped \(branch_not_watched\)$'
stdout '^18 Nov 2026 12:00  acme/web    PR #412 open, proven · fixes F-07$'

# One entry, as the web app shows it.
fake-hkr activity.get.delivery activity.get.pull_request activity.get.dependencies activity.get.not_found
exits 0 hkr activity show delivery-EvtSkip7Kq2X
stdout '^push spike/search b4e32d0a9f8e by ana on acme/web, 18 Nov 2026 12:00$'
stdout '^Outcome    skipped \(branch_not_watched\)$'
stdout '^Host       github$'
stdout '^Delivery   d-activity-skipped$'

# A fix pull request: the verdict, the test runs, then the whole patch.
exits 0 hkr activity show pull_request-FixProp7Kq2X
stdout '^PR #412 on acme/web: open, proven · fixes F-07 SQL injection in the search handler$'
stdout '^Pull request  https://github\.com/acme/web/pull/412$'
stdout '^Branch        hkr/fix-f-07$'
stdout '^Opened by     HKr, under the fix policy$'
stdout '^Tests         mix test: exit 1 → 0$'
! stdout '^Reproduction'
stdout '^\+Repo\.query\("SELECT \* FROM items WHERE name = \$1", \[q\]\)$'

exits 0 hkr activity show dependencies-SynLock7Kq2X
stdout '^lock files main a1b2c3d4e5f6 on acme/web: complete, 1/1 read$'
stdout '^PATH  ECOSYSTEMS  PACKAGES$'
stdout '^\.     npm         1$'

exits 0 hkr activity show pull_request-FixProp7Kq2X --json
stdout '"patch": '

exits 1 hkr activity show delivery-Nope7Kq2XpAb
stderr 'That doesn''t exist'

# hkr open activity: the entry's page in the web app.
exits 0 hkr open activity pull_request-FixProp7Kq2X --no-browser
stdout '^http://127\.0\.0\.1:\d+/code/RepWeb7Kq2Xp/pull-requests/FixProp7Kq2X$'

# An upgrade: the package and what HKr read back from the lock file.
fake-hkr activity.get.pull_request_dependency
exits 0 hkr activity show pull_request-FixBump7Kq2X
stdout '^PR #413 on acme/web: open, verified · upgrades lodash 4\.17\.20 → 4\.17\.21$'
stdout '^Upgraded      lodash 4\.17\.21, 4\.17\.23$'
stdout '^Tests         npm test: exit 0 → 0$'
stdout '^CVE           hkr deps show \S+$'

# A read of the lock files: the projects; --packages adds what each resolved.
fake-hkr activity.get.dependencies
exits 0 hkr activity show dependencies-SynLock7Kq2X
! stdout lodash
exits 0 hkr activity show dependencies-SynLock7Kq2X --packages
stdout '^\. \(npm, 1 package\)$'
stdout '^NAME    VERSION  ECOSYSTEM  DIRECT  SCOPE$'
stdout '^lodash  4\.17\.20  npm        yes     runtime$'
