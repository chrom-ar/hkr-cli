# Dependency CVEs across the organization's repositories.
env HKR_TOKEN=hkrp_test_token_laptop
env HKR_ORG=acme
fake-hkr deps.list.ok deps.list.filtered dep.get.ok dep.fix.created dep.restore.ok dep.dismiss.not_dismissable
exits 0 hkr deps list
stdout '^ID            SEVERITY  EXPLOITED  EPSS   PACKAGE         FIXED IN  REPOSITORY  STATUS  ADVISORY$'
stdout '^ExpLoda7Kq2X  high      yes        91\.2%  lodash@4\.17\.20  4\.17\.21   acme/web    open    CVE-2026-6100$'

exits 0 hkr deps list --status dismissed,resolved --repo RepWeb7Kq2Xp
stdout '^No dependency CVEs\.$'

exits 2 hkr deps list --status gone
stderr 'unknown --status "gone": use open, awaiting_credit, resolved or dismissed'

exits 0 hkr deps show ExpLoda7Kq2X
stdout '^lodash@4\.17\.20 \(npm, runtime\) in acme/web: CVE-2026-6100$'
stdout '^Severity  high$'
stdout '^Fixed in  4\.17\.21$'
stdout '^Summary   Prototype pollution in lodash$'
# Whether it's exploited: CISA's KEV and SSVC, FIRST's EPSS.
stdout '^Exploited yes, in CISA''s KEV since 10 Nov 2026; fix by 1 Dec 2026$'
stdout '^Action    Apply mitigations per vendor instructions\.$'
stdout '^SSVC      exploitation active, automatable, technical impact partial$'
stdout '^EPSS      91\.2% chance of exploitation in 30 days \(above 99\.8% of CVEs, 18 Nov 2026\)$'
stdout '^CWE       CWE-1321$'

# fix spends credit: it asks, or --yes.
exits 2 hkr deps fix ExpLoda7Kq2X
stderr 'an upgrade costs credit: pass --yes'
exits 0 hkr deps fix ExpLoda7Kq2X --yes
stdout '^Asked for fix FixWeb7Kq2Xp \(pending\)\.$'

exits 0 hkr deps restore ExpLoda7Kq2X
stdout '^ExpLoda7Kq2X is open\.$'
exits 1 hkr deps dismiss ExpLoda7Kq2X
stderr '^error: Only an open dependency CVE can be dismissed\.$'

fake-hkr dep.dismiss.ok
exits 0 hkr deps dismiss ExpLoda7Kq2X
stdout '^ExpLoda7Kq2X is dismissed\.$'
