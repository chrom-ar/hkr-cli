# hkr login: the device flow. The code and URL go to stderr, the device
# code never shows, and the token is stored (in a file here: tests have
# no keychain).
fake-hkr login.device.ok login.token.pending login.token.slow_down login.token.ok me.ok me.token.delete.ok
exits 0 hkr login
stdout '^Signed in to http://127\.0\.0\.1:\d+ as ada@example.com \(token "laptop", write access\)\.$'
stderr '^First copy your one-time code: WDJB-MJHT$'
stderr '^You''re in 2 organizations\. Pick one: hkr use <org>$'
stderr '^Then open http://127\.0\.0\.1:\d+/login/device and enter it\.$'
stderr 'No keychain found: the token is kept in .*tokens\.json, readable only by you\.'
! stderr dc_test_device_code
! stdout hkrp_
! stderr hkrp_
! exists browser.log
grep hkrp_test_token_device config/hkr/tokens.json
grep '"url": "http://127' config/hkr/config.json

# Signed in: whoami works without HKR_URL, from the config.
env HKR_URL=
exits 0 hkr whoami
stdout '^ada@example.com \(Ada Lovelace\) on http://127\.0\.0\.1:\d+$'
stdout '^Token "laptop": write access$'
stdout '^ORGANIZATION  NAME    ROLE$'
stdout '^acme          Acme    admin$'
stdout '^globex        Globex  member$'
! stderr .

# --json prints /me as is.
exits 0 hkr whoami --json
stdout '"organizations": \['
stdout '"access": "write"'

# logout revokes the token and forgets it.
exits 0 hkr logout
stdout '^Signed out of http://127\.0\.0\.1:\d+\.$'
! grep hkrp_test_token_device config/hkr/tokens.json

exits 0 hkr logout
stdout '^Not signed in to http://127\.0\.0\.1:\d+\.$'

exits 3 hkr whoami
stderr '^error: not signed in to http://127\.0\.0\.1:\d+\.$'
stderr '^run: hkr login \(or set HKR_TOKEN\)$'
! stdout .

# HKR_TOKEN wins, and whoami says so.
fake-hkr me.narrowed
env HKR_TOKEN=hkrp_test_token_narrowed
exits 0 hkr whoami
stdout '^Token "ci" from HKR_TOKEN: read-only access, only acme$'

# logout with HKR_TOKEN set is a usage error, and calls nothing.
exits 2 hkr logout
stderr 'HKR_TOKEN is set'

# A rejected token exits 3 with HKr's message and the login hint.
fake-hkr me.unauthorized
env HKR_TOKEN=hkrp_test_revoked
exits 3 hkr whoami
stderr '^error: This token is unknown or was revoked\. Sign in again\.$'
stderr '^run: hkr login$'
! stderr hkrp_test_revoked

# Under --json, the error is one JSON object on stderr.
exits 3 hkr whoami --json
stderr '^\{"error":\{"code":"unauthorized","message":"This token'
! stdout .

# --lang must be en or es.
exits 2 hkr whoami --lang fr
stderr 'unknown language "fr": use en or es'

# A flag the command doesn't take is a usage error.
exits 2 hkr whoami --markdown
stderr 'unknown flag: --markdown'

# A bad --url is a usage error.
exits 2 hkr whoami --url ftp://x
stderr 'invalid HKr URL'
